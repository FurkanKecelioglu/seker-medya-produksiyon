# Örnek ortam değişkenleri — gerçek sır içermez. Kopyala: .env
# MySQL 8 kullanıcısı mysql_native_password ile açılmalı (rehber §7.1/2).
DATABASE_URL="mysql://seker:PAROLA@127.0.0.1:3306/seker"
# En az 32 karakter rastgele:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Panel oturumu ve teklif formu jetonu bununla imzalanır. Değişirse herkes panelden düşer.
OTURUM_SIRRI=""
# Canlıda https://alanadi.com — çerezin secure olması, canonical ve paylaşım
# görseli adresleri buna bakar. Sonda / olmadan.
SITE_URL="http://localhost:3060"
# Yüklenen fotoğraf ve videolar: uygulama dizininin DIŞINDA bir klasör
# (canlıda /var/lib/seker/yuklemeler). Uygulama dizinine yazılırsa dağıtımda silinir.
YUKLEME_DIZINI=""
# Yalnız yerel geliştirme: seed'in açacağı "yonetici" hesabının şifresi.
# Canlıda BOŞ bırak: seed rastgele şifre üretir ve bir kez ekrana yazar.
SEED_SIFRE_YONETICI=""
